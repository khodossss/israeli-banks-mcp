# kesef.ai credentials and settings — template.
# Easiest: don't edit this by hand — run the setup form (ask your agent to "set up kesef",
# or `npm run setup` in a checkout). It writes .env for you.
#
# Manual route: copy this file to .env inside KESEF_HOME (default ~/.kesef) and fill in only
# the providers you have. Placeholder values (your_…) and commented-out keys are ignored,
# so providers you don't use can stay as they are. .env never leaves your machine.

# ===== Isracard (credit card) =====
# The library logs in with these; you only pass the Cloudflare check.
ISRACARD_ID=your_teudat_zehut
ISRACARD_CARD6DIGITS=last_6_digits_of_card
ISRACARD_PASSWORD=your_isracard_password

# ===== Bank Hapoalim =====
# Auto-filled into the login form; you only type the SMS code in the window.
HAPOALIM_USERCODE=your_user_code
HAPOALIM_PASSWORD=your_password

# ===== Bank Leumi =====
# The library logs in by itself (username + password, no OTP).
LEUMI_USERNAME=your_username
LEUMI_PASSWORD=your_password

# ===== Cal / כאל (credit card) =====
# The library logs in by itself (username + password, no OTP).
CAL_USERNAME=your_username
CAL_PASSWORD=your_password

# ===== Settings (optional) =====
# Months of history to fetch (default 12).
SCRAPE_MONTHS_BACK=12
# Browser executable, if Chrome/Edge is not in a standard location.
# CHROME_PATH=/path/to/chrome

# ===== Family mode (optional; written by the family_* tools — see FAMILY.md) =====
# HOUSEHOLD_STORAGE=relay   # relay | local
# HOUSEHOLD_TOKEN=          # relay: from family_create, or received from family — a CREDENTIAL
# HOUSEHOLD_DIR=            # local: path to the shared, synced folder
# RELAY_URL=                # relay: your Cloudflare Worker URL (see relay/README.md)
# MEMBER_ID=                # set automatically by family_create / family_join
# MEMBER_INFO=              # optional display label ("Dima"); empty → "Member N"
